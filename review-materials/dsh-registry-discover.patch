-  if (!repo || `${repo.owner}/${repo.repository}`.toLowerCase() !== fullName.toLowerCase()) return { reason: 'repository_mismatch' }
+  const fullName = repo && `${repo.owner}/${repo.repository}`
+  const url = `https://github.com/${fullName}`
+  let commit = plugin.verifiedCommit
+  let checkArchivePatches = false
+  if (install.spec.startsWith('github:')) {
+    if (!githubSpecIsPinned(install.spec, commit)) return { reason: 'not_pinned' }
+    const installedRepo = install.spec.slice('github:'.length).split('#')[0]
+    if (!repo || installedRepo.toLowerCase() !== fullName.toLowerCase()) return { reason: 'repository_mismatch' }
+  } else {
+    // A curator can point the record at a public installable subpackage of
+    // the same reviewed archive. A branch name or moving tag is insufficient.
+    const pin = String(plugin.url || '').match(/\/tree\/([0-9a-f]{40})\//)?.[1]
+    if (!repo || plugin.source !== 'curated' || !pin || install.spec !== `${url}/archive/${pin}.tar.gz`) return { reason: 'not_github' }
+    commit = pin
+    checkArchivePatches = true
+  }
   const directory = bundleDirectoryFromUrl(plugin.url)
   // A qualified id only identifies a basename; it cannot recover a lost monorepo path.
   if (String(plugin.id).includes('#') && !directory) return { reason: 'directory_unknown' }
   if (directory && directory.split('/').some(part => part === '.' || part === '..' || !/^[A-Za-z0-9._@+-]+$/.test(part))) return { reason: 'directory_invalid' }
   if (typeof plugin.packageName !== 'string' || !plugin.packageName.trim()) return { reason: 'package_name_missing' }
-  return { plugin, fullName, directory, commit: plugin.verifiedCommit, url: `https://github.com/${repo.owner}/${repo.repository}` }
+  return { plugin, fullName, directory, commit, url, checkArchivePatches }
 }
 
 function sourceKey(source) {
@@ -151,6 +164,21 @@ async function requestMetadata(query, fetchImpl, token, sleep) {
   }
 }
 
+async function verifyArchivePatches(item, paths, fetchImpl, token, sleep) {
+  const [owner, name] = item.fullName.split('/')
+  const fields = paths.map((patch, index) => {
+    const file = `${item.commit}:${item.directory}/${patch.slice(2)}`
+    return `p${index}: object(expression: ${JSON.stringify(file)}) { ... on Blob { text } }`
+  })
+  const query = `query { repository(owner: ${JSON.stringify(owner)}, name: ${JSON.stringify(name)}) { ${fields.join(' ')} } }`
+  const result = await requestMetadata(query, fetchImpl, token, sleep)
+  const repository = result.data?.repository
+  if (result.errors?.length || !isObject(repository) || paths.some((_, i) => !Object.hasOwn(repository, `p${i}`))) {
+    throw new Error('GitHub archive patch metadata is incomplete; previous index retained')
+  }
+  return paths.every((_, i) => validateBundlePatch(repository[`p${i}`]?.text).valid)
+}
