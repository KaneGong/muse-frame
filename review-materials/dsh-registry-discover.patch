diff --git a/tests/plugin-market-index.test.mjs b/tests/plugin-market-index.test.mjs
index 8ec7f85..93e2f60 100644
--- a/tests/plugin-market-index.test.mjs
+++ b/tests/plugin-market-index.test.mjs
@@ -252,3 +252,38 @@ test('failed refresh leaves the old artifact byte-for-byte intact; successful re
     assert.equal(parseMarketIndex(saved, 'https://example.org/index.json').plugins[0].versions[0].source.commit, SHA)
   } finally { await rm(root, { recursive: true, force: true }) }
