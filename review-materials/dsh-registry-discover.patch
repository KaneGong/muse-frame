+
+test('a curated archive can export its public subpackage at the reviewed SHA', async () => {
+  const url = 'https://github.com/owner/bundle'
+  const archive = plugin({
+    source: 'curated',
+    url: `${url}/tree/${SHA}/plugins/planner`,
+    verifiedCommit: 'a'.repeat(40),
+    install: `dsh plugin --profile web add ${url}/archive/${SHA}.tar.gz`,
+  })
+  const queries = []
+  const fetchAtPin = (text = '[]') => async (url, options) => {
+    const { query } = JSON.parse(options.body)
+    queries.push(query)
+    if (query.includes('p0: object')) return { ok: true, json: async () => ({ data: { repository: { p0: text === null ? null : { text } } } }) }
+    return github(metadata())(url, options)
+  }
+  const generated = await generate([archive], undefined, { fetchImpl: fetchAtPin() })
+  const record = generated.index.plugins[0]
+  assert.equal(marketInstallTarget(record.name, record.versions[0]).spec, `git+https://github.com/owner/bundle.git#${SHA}&path:/plugins/planner`)
+  assert(queries.some(query => query.includes(`${SHA}:plugins/planner/package.json`)))
+  assert(queries.some(query => query.includes(`${SHA}:plugins/planner/cordis.patch.yml`)))
+  for (const patch of ['{}', null]) {
+    const rejected = await generate([archive], undefined, { fetchImpl: fetchAtPin(patch) })
+    assert.equal(rejected.stats.skipped.bundle_invalid, 1)
+  }
+  assert.equal((await generate([archive], manifest({ private: true }))).stats.skipped.package_private, 1)
+  for (const changed of [
+    { source: 'discovered' }, { url: `${url}/tree/main/plugins/planner` },
+    { install: archive.install.replace('/owner/', '/another-owner/') },
+    { install: archive.install.replace(SHA, 'f'.repeat(40)) },
+  ]) {
+    const rejected = await generate([{ ...archive, ...changed }])
+    assert.equal(rejected.stats.skipped.not_github, 1)
+  }
+})
